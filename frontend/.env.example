# Backend REST API base URL (the backend serves with global prefix /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Backend root for Socket.IO websockets (no /api suffix).
# In production this is your Render/Railway backend URL, e.g.
# https://kokoro-march-api.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional: Cloudinary cloud name for direct-upload display hints
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
