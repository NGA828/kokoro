# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Exact origin(s) of the frontend, used for CORS + Socket.IO allow-list.
# Multiple origins can be comma-separated.
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────
# Use "sqlite" for zero-setup local development (file under data/),
# or "mysql" for production / MySQL dev.
DB_TYPE=sqlite
DATABASE_SQLITE_PATH=data/kokoro-dev.db

# MySQL settings (used when DB_TYPE=mysql)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=kokoro_march
DATABASE_USER=kokoro
DATABASE_PASSWORD=change-me
# false in production (use migrations); true is convenient for dev.
DB_SYNCHRONIZE=true

# ── Auth / JWT ──────────────────────────────────────────
# Use long random strings in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# ── Media storage (Cloudinary; optional) ────────────────
# Leave blank to store uploads on local disk (served at /media).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments ────────────────────────────────────────────
# "mock" simulates immediate success so the whole flow is testable
# without real money. Production providers plug into PaymentsService.
PAYMENT_PROVIDER=mock

# Email verification / password reset (architecture ready; console only
# until an SMTP/transactional-email provider is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@kokoromarch.com
